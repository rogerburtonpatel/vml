#!/bin/bash
#
# Purpose: Compare interpreter vs. compiler output for VMinus programs.
# Tests that either:
#   (1) Both succeed and produce the same output, or
#   (2) Both fail (nonzero exit code).
#
# If one fails but the other succeeds, the test fails.
#

# Script enhanced by AI. 

BASEDIR=$DIRVML
SRC=$DIRVML/src
TESTDIR=$BASEDIR/tests/$(basename "$0")

build() {
    cd "$SRC" || exit 1

    output=$(make 2>&1)
    if [[ "$?" -ne 0 ]]; then
        echo "$output"
        echo "Exiting on compilation failure."
        exit 1
    fi
}

numtests=0
numfail=0
declare -a failed_tests

run_one_test() {
    local file=$1
    numtests=$((numtests + 1))

    compare-vm-d "$file"
    result=$?

    if [[ $result -ne 0 ]]; then
        numfail=$((numfail + 1))
        failed_tests+=("$file")
    fi
}


run_tests() {
    shopt -s nullglob
    for file in "$TESTDIR"/*.vm; do
        run_one_test "$file"
    done
    shopt -u nullglob

    echo
    echo "========== SUMMARY =========="

    if [[ "$numtests" -eq 0 ]]; then
        >&2 echo "$(basename "$0"): No tests run. Check test directory."
        exit 1
    fi

    if [[ "$numfail" -eq 0 ]]; then 
        echo "All $numtests tests passed."
    else 
        numpassed=$((numtests - numfail))
        echo "⚠️  $numpassed / $numtests tests passed."
        echo
        echo "Failed tests:"
        for f in "${failed_tests[@]}"; do
            echo "  - $f"
        done
        echo
        echo "See above output for details."
        exit 1
    fi
}

main() {
    build 
    run_tests
}

main
