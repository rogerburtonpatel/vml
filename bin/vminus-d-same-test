#!/bin/bash
#
# Purpose: Compare interpreter vs. compiler output for VMinus programs.
# Tests that either:
#   (1) Both succeed and produce the same output, or
#   (2) Both fail (nonzero exit code).
#
# If one fails but the other succeeds, the test fails.
#

# Script enhanced by AI.

set -euo pipefail

BASEDIR=$DIRVML
SRC=$DIRVML/src
TESTDIR=$BASEDIR/tests/$(basename "$0")

build() {
    echo "=== Building sources in $SRC ==="
    cd "$SRC" || exit 1

    if ! make; then
        echo "❌ Exiting on compilation failure."
        exit 1
    fi
    echo "✅ Build succeeded."
    echo
}

numtests=0
numfail=0
numpass=0
declare -a failed_tests

run_one_test() {
    local file=$1
    numtests=$((numtests + 1))

    # Run compare-vm-d with live output
    set +e
    output=$(compare-vm-d "$file" 2>&1)
    result=$?
    set -e

    echo "$output"
    echo "-----------------------------------"

    if [[ $result -ne 0 ]]; then
        echo "❌ Test FAILED: $file"
        echo
        failed_tests+=("$file")
        numfail=$((numfail + 1))
    else
        echo "✅ Test PASSED: $file"
        numpass=$((numpass + 1))
    fi

    echo
}

run_tests() {
    shopt -s nullglob
    local files=("$TESTDIR"/*.vm)
    shopt -u nullglob

    if [[ ${#files[@]} -eq 0 ]]; then
        >&2 echo "$(basename "$0"): No tests found in $TESTDIR"
        exit 1
    fi

    for file in "${files[@]}"; do
        run_one_test "$file"
    done

    echo
    echo "========== SUMMARY =========="
    echo "Total tests: $numtests"
    echo "Passed:      $numpass"
    echo "Failed:      $numfail"
    echo

    if [[ $numfail -gt 0 ]]; then
        echo "❌ Some tests failed:"
        for f in "${failed_tests[@]}"; do
            echo "  - $f"
        done
        exit 1
    else
        echo "✅ All tests passed successfully."
        exit 0
    fi
}

main() {
    build
    run_tests
}

main
