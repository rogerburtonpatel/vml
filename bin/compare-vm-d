#!/bin/bash
#
# compare-vm-d.sh — Compare vminus vs. dtran|d for a single .vm test file.
#
# Usage: ./compare-vm-d.sh path/to/testfile.vm
#
# Exit codes:
#   0 = Test passed (matches expected outcome)
#   1 = Test failed (mismatch or unexpected behavior)
#


file=$1
if [[ -z "${file:-}" ]]; then
    echo "Usage: $0 <file.vm>"
    exit 1
fi

if [[ ! -f "$file" ]]; then
    echo "Error: file not found: $file"
    exit 1
fi

# Determine expected outcome from filename
if [[ "$file" =~ succeeds ]]; then
    expected=0
elif [[ "$file" =~ fails ]]; then
    expected=1
else
    echo "⚠️  Warning: could not infer expected outcome from filename, assuming success"
    expected=0
fi

# ---- Run interpreter ----
vminus_out=$(vminus "$file" 2>&1 | tee /tmp/vminus_out.$$)
vminus_code=${PIPESTATUS[0]}

# ---- Run compiler + VM ----
dtran_out=$(dtran vm-d "$file" 2>&1 | tee /tmp/dtran_out.$$)
dtran_code=${PIPESTATUS[0]}

if [[ $dtran_code -eq 0 ]]; then
    d_out=$(cat /tmp/dtran_out.$$ | d 2>&1 | tee /tmp/d_out.$$)
    d_code=${PIPESTATUS[0]}
else
    d_out=""
    d_code=$dtran_code
fi

full_dtran_out="$d_out"
full_dtran_code=$d_code

# ---- Determine comparison logic ----
if [[ $vminus_code -ne 0 && $full_dtran_code -ne 0 ]]; then
    echo "✅ Both failed (expected failure behavior): $file"
    actual=1

elif [[ $vminus_code -eq 0 && $full_dtran_code -eq 0 ]]; then
    # Check if outputs match ignoring whitespace
    if diff -w <(echo "$vminus_out") <(echo "$full_dtran_out") >/dev/null; then
        echo "✅ Both succeeded with matching output: $file"
        exit 0
    elif [[ "$vminus_out" == *"Failed on expression"* && "$full_dtran_out" == *"Failed on expression"* ]]; then
        echo "✅ Both failed with 'Failed on expression' present: $file"
        exit 0
    else
        echo "❌ Output mismatch (both succeeded): $file"
        echo "--- vminus output ---"
        echo "$vminus_out"
        echo "--- dtran|d output ---"
        echo "$full_dtran_out"
        echo "--- diff (ignoring whitespace) ---"
        diff --color=always -w <(echo "$vminus_out") <(echo "$full_dtran_out") || true
        actual=1
    fi

else
    echo "❌ One succeeded and the other failed: $file"
    echo "--- vminus (exit $vminus_code) ---"
    echo "$vminus_out"
    echo "--- dtran|d (exit $full_dtran_code) ---"
    echo "$full_dtran_out"
    exit 1
fi

# ---- Compare actual vs expected ----
if [[ $actual -eq $expected ]]; then
    echo "✅ Test passed (matches expected outcome): $file"
    exit 0
else
    echo "❌ Test FAILED (does not match expected outcome): $file"
    echo "--- vminus (exit $vminus_code) ---"
    echo "$vminus_out"
    echo "--- dtran|d (exit $full_dtran_code) ---"
    echo "$full_dtran_out"
    echo "--- diff (ignoring whitespace) ---"
    diff --color=always -w <(echo "$vminus_out") <(echo "$full_dtran_out") || true
    exit 1
fi
